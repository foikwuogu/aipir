# Grafana single sign-on with Microsoft Entra ID (Zero-Trust: no local accounts, roles from the IdP).
# Copy to grafana-oidc.env (git-ignored), fill in, and add `env_file: [grafana-oidc.env]` to the
# grafana service. Users must have an AIPIR app role; MFA is enforced by the Conditional Access
# policy in deploy/terraform/modules/entra-zero-trust.
GF_AUTH_DISABLE_LOGIN_FORM=true
GF_AUTH_ANONYMOUS_ENABLED=false
GF_AUTH_AZUREAD_ENABLED=true
GF_AUTH_AZUREAD_NAME=Entra ID
GF_AUTH_AZUREAD_CLIENT_ID=<grafana app registration client id>
GF_AUTH_AZUREAD_CLIENT_SECRET=<from your secret store>
GF_AUTH_AZUREAD_SCOPES=openid email profile
GF_AUTH_AZUREAD_AUTH_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/authorize
GF_AUTH_AZUREAD_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
GF_AUTH_AZUREAD_ALLOW_SIGN_UP=true
GF_AUTH_AZUREAD_ROLE_ATTRIBUTE_STRICT=true
GF_AUTH_AZUREAD_SKIP_ORG_ROLE_SYNC=false
